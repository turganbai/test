# Copy to .env and fill in. The real environment wins over this file, and .env
# is gitignored — the API token must not be committed.
#
# Values may be quoted ("..." takes \n \t \" escapes, '...' is literal);
# an unquoted value ends at a whitespace-preceded # comment.

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Find it with GET /rest/api/3/field
JIRA_DEVELOPER_FIELD_ID=customfield_10050

# One of the two is required; run ./jira-returns -statuses to list them (that
# command needs only the URL, the email and the token).
JIRA_RETURNED_STATUS_IDS=10007,10008
#JIRA_RETURNED_STATUS_NAMES='Returned,Возвращено'

# Optional.
#JIRA_CODE_REVIEW_STATUS_IDS=10001
#JIRA_ATTRIBUTION_MODE=current
#JIRA_CONCURRENCY=5
#JIRA_TIMEOUT=60s
#LOG_LEVEL=info
